# Docker Compose / local environment configuration
# No secrets here — API keys are entered in the web UI and never stored.

# Default OpenAI-compatible endpoint (provider "OpenAI Compatible").
DEFAULT_BASE_URL=

# Provider selected by default on first load.
DEFAULT_PROVIDER=openai

# Optional shell command to restart after update (for systemd / supervisor)
# RESTART_CMD=systemctl restart model-lister
