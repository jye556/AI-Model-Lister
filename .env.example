# Docker Compose / local environment configuration
# No secrets here — API keys are entered in the web UI and never stored.

# Default OpenAI-compatible endpoint (provider "OpenAI Compatible").
DEFAULT_BASE_URL=

# Provider selected by default on first load.
DEFAULT_PROVIDER=openai

# User-defined providers (Settings → Server Environment → Custom Providers).
# JSON array of {"id", "label", "base_url"} objects. The compact form
# "id|label|base_url;id2|label2|base_url2" is also accepted.
# CUSTOM_PROVIDERS=[{"id":"my-llm","label":"My LLM","base_url":"https://api.example.com/v1"}]

# Order of the provider dropdowns (Settings → Server Environment → Provider Order).
# Comma-separated provider ids; unlisted providers keep their default order.
# PROVIDER_ORDER=my-llm,openai,openrouter

# Built-in providers the user removed from the provider dropdowns. Comma-separated
# provider ids; they can be restored from the Settings panel at any time.
# HIDDEN_PROVIDERS=azure,gemini

# Edited providers: a JSON object of per-provider label / base URL overrides.
# {"claude": {"label": "Claude (EU)", "base_url": "https://eu.anthropic.com/v1"}}
# The OpenAI-compatible provider's base URL always comes from DEFAULT_BASE_URL.
# PROVIDER_OVERRIDES={"claude":{"label":"Claude (EU)","base_url":"https://eu.anthropic.com/v1"}}

# Optional shell command to restart after update (for systemd / supervisor)
# RESTART_CMD=systemctl restart model-lister
