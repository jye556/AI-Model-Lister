# Docker Compose reads this file automatically. No secrets here — API keys are
# entered in the web UI and never stored. Edit these values to suit your setup.

# Default OpenAI-compatible endpoint (provider "OpenAI Compatible").
DEFAULT_BASE_URL=https://sub2api.midah.my/v1

# Provider selected by default on first load.
DEFAULT_PROVIDER=openai

# Where the app checks version.txt for self-updates.
GITHUB_REPO=jye556/AI-Model-Lister

# Branch to pull when the Update button is pressed.
UPDATE_BRANCH=main
